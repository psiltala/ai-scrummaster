# Azure DevOps Boards entry point (src/boards). Stdlib only: no pip install, no crewai.
# cloudbuild-boards.yaml overrides BASE_IMAGE with a digest-pinned registry mirror.
ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app
COPY src/__init__.py src/llm_json.py ./src/
COPY src/boards/ ./src/boards/

# Matches the restricted pod securityContext the platform sets (runAsUser 1001).
USER 1001:1001
EXPOSE 8080

CMD ["python3", "-m", "src.boards.app"]
